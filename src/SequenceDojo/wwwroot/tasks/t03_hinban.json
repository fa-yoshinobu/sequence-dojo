{
  "title": "練習3 品番判別と表示",
  "grade": 2,
  "description": "【品番】ワーク左端で LS3=1, LS4=2, LS5=4 の重みで合計した値を品番（0〜7）とする。\n\n【仕様】\n1. SS0=自動のとき、ワークが左端（LS2 ON）で PB1 を押すと、その時点の品番を DPL1 に表示し、右行を開始する。\n2. DPL2 には DSW の設定値を常時表示する。\n3. LS1 で停止する。品番と DSW の設定値が一致していれば PL3 を点灯、不一致なら PL4 を点灯する。\n4. SS1=入（連続運転）のときは、LS1 で停止してから 2秒後に左行を開始し、LS2 で停止する。\n5. 左行を開始したら PL3・PL4 を消灯する。\n6. PB5（非常停止）でコンベアを直ちに停止する。",
  "scenario": [
    { "reset": true },
    { "ss0": true },
    { "dsw": 5 },
    { "wait": 300 },
    { "expect": { "DPL2": 5 }, "msg": "DPL2 に DSW 設定値 5 を表示" },
    { "work": { "at": "left", "screws": [1, 0, 1, 1] } },
    { "press": "PB1", "ms": 300 },
    { "wait": 300 },
    { "expect": { "DPL1": 5, "conveyor": "right" }, "msg": "品番5（LS3+LS5）を表示し右行" },
    { "waitFor": { "LS1": true }, "timeout": 8000, "msg": "右端に到達" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop", "PL3": true, "PL4": false }, "msg": "一致 → PL3 点灯" },
    { "note": "--- 不一致 + 連続運転 ---" },
    { "clearWorks": true },
    { "dsw": 2 },
    { "ss1": true },
    { "work": { "at": "left", "screws": [0, 0, 1, 1] } },
    { "press": "PB1", "ms": 300 },
    { "wait": 300 },
    { "expect": { "DPL1": 1, "DPL2": 2, "conveyor": "right" }, "msg": "品番1 を表示し右行" },
    { "waitFor": { "LS1": true }, "timeout": 8000, "msg": "右端に到達" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop", "PL4": true, "PL3": false }, "msg": "不一致 → PL4 点灯" },
    { "expectFor": { "conveyor": "stop" }, "ms": 1400, "msg": "2秒待機中は停止" },
    { "waitFor": { "conveyor": "left" }, "timeout": 1200, "msg": "約2秒後に左行開始" },
    { "expect": { "PL4": false }, "msg": "左行開始で PL4 消灯" },
    { "waitFor": { "LS2": true }, "timeout": 8000, "msg": "左端に戻る" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop" }, "msg": "LS2 で停止" }
  ]
}
