{
  "title": "練習2 コンベアの手動・自動運転",
  "grade": 3,
  "description": "【仕様】\n■ 手動（SS0=手動）\n1. PB3 を押している間だけコンベアを左行、PB4 を押している間だけ右行させる（寸動）。\n2. 左行中に LS2、右行中に LS1 が ON になったら停止する。\n\n■ 自動（SS0=自動）\n3. ワークが左端（LS2 ON）にあるとき PB1 を押すと右行し、LS1 で停止して PL2 を点灯する。\n4. ワークが右端（LS1 ON）にあるとき PB2 を押すと左行し、LS2 で停止して PL1 を点灯する。\n5. PL1・PL2 は次の運転開始で消灯する。\n\n■ 共通\n6. PB5（非常停止）でコンベアを直ちに停止する。\n7. RY1（左行）と RY2（右行）は同時に ON しないこと。",
  "scenario": [
    { "reset": true },
    { "ss0": false },
    { "work": { "at": "center", "screws": [0, 0, 0, 1] } },
    { "note": "--- 手動運転 ---" },
    { "hold": "PB4", "on": true },
    { "wait": 400 },
    { "expect": { "conveyor": "right" }, "msg": "PB4 を押している間 右行" },
    { "hold": "PB4", "on": false },
    { "wait": 300 },
    { "expect": { "conveyor": "stop" }, "msg": "PB4 を離すと停止" },
    { "hold": "PB3", "on": true },
    { "wait": 400 },
    { "expect": { "conveyor": "left" }, "msg": "PB3 を押している間 左行" },
    { "waitFor": { "LS2": true }, "timeout": 8000, "msg": "左端に到達" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop" }, "msg": "LS2 で停止（PB3 押しっぱなしでも）" },
    { "hold": "PB3", "on": false },
    { "note": "--- 自動運転 ---" },
    { "ss0": true },
    { "press": "PB1", "ms": 300 },
    { "waitFor": { "conveyor": "right" }, "timeout": 1000, "msg": "PB1 で右行開始" },
    { "waitFor": { "LS1": true }, "timeout": 8000, "msg": "右端に到達" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop", "PL2": true }, "msg": "LS1 で停止し PL2 点灯" },
    { "press": "PB2", "ms": 300 },
    { "waitFor": { "conveyor": "left" }, "timeout": 1000, "msg": "PB2 で左行開始" },
    { "expect": { "PL2": false }, "msg": "運転開始で PL2 消灯" },
    { "waitFor": { "LS2": true }, "timeout": 8000, "msg": "左端に到達" },
    { "wait": 300 },
    { "expect": { "conveyor": "stop", "PL1": true }, "msg": "LS2 で停止し PL1 点灯" },
    { "note": "--- 非常停止 ---" },
    { "press": "PB1", "ms": 300 },
    { "wait": 1000 },
    { "hold": "PB5", "on": true },
    { "wait": 300 },
    { "expect": { "conveyor": "stop" }, "msg": "PB5 で直ちに停止" },
    { "hold": "PB5", "on": false }
  ]
}
